# Go Auth API Configuration

# Server Configuration
PORT=8080
GIN_MODE=debug

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production

# Database Configuration
# Supported types: sqlite, mysql
DATABASE_TYPE=sqlite

# SQLite Configuration (when DATABASE_TYPE=sqlite)
DATABASE_URL=./auth.db

# MySQL Configuration (when DATABASE_TYPE=mysql)
# DATABASE_URL=username:password@tcp(localhost:3306)/auth_db?charset=utf8mb4&parseTime=True&loc=Local

# MySQL Seed Script Configuration (only for scripts/seed_db_mysql.sh)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=auth_db
