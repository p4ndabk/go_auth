# Server
PORT=8080
GIN_MODE=debug

# JWT
JWT_SECRET=your-secret-key-change-this-in-production

# Database — DB_DRIVER: sqlite (default) or mysql
DB_DRIVER=sqlite

# SQLite (when DB_DRIVER=sqlite)
DB_PATH=data/go_auth.db

# MySQL (when DB_DRIVER=mysql)
# DB_DSN=username:password@tcp(localhost:3306)/go_auth?charset=utf8mb4&parseTime=True&loc=Local

# CORS: "*" or a comma-separated allowlist
CORS_ALLOWED_ORIGINS=*
